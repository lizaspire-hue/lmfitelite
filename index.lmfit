<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>LMFIT Private | Executive Health & Performance Coaching for Women | London</title>
<meta name="description" content="Private, fully personalised health and performance coaching for high-achieving women in London. Hormone and biomarker testing, a specialist team, and 1-to-1 coaching with Liz Marsland, BSc Sports Science, 20+ years experience.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --navy-900:#060d1f;
    --navy-800:#0a1530;
    --navy-700:#0f1f45;
    --navy-600:#16295a;
    --line:rgba(255,255,255,.10);
    --text:#e8ecf5;
    --muted:#9aa6c2;
    --accent:#7fd4e8;      /* LMFIT cyan, softened */
    --gold:#c9a96e;        /* premium highlight */
    --serif:'Cormorant Garamond', Georgia, serif;
    --sans:'Poppins', system-ui, sans-serif;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{font-family:var(--sans);font-weight:300;background:var(--navy-900);color:var(--text);line-height:1.7;-webkit-font-smoothing:antialiased}
  img{max-width:100%;display:block}
  a{color:inherit;text-decoration:none}
  .wrap{max-width:1180px;margin:0 auto;padding:0 24px}
  h1,h2,h3{font-family:var(--serif);font-weight:500;line-height:1.15;letter-spacing:.2px}
  h1{font-size:clamp(2.6rem,6vw,4.6rem)}
  h2{font-size:clamp(2rem,4vw,3rem);margin-bottom:18px}
  h3{font-size:1.55rem;margin-bottom:10px}
  em{font-style:italic;color:var(--gold)}
  .eyebrow{font-size:.75rem;letter-spacing:.28em;text-transform:uppercase;color:var(--accent);font-weight:500;margin-bottom:18px;display:block}
  .lead{font-size:1.1rem;color:var(--muted);max-width:640px}
  section{padding:110px 0;border-top:1px solid var(--line)}
  .btn{display:inline-block;padding:15px 32px;font-size:.82rem;letter-spacing:.16em;text-transform:uppercase;font-weight:500;border:1px solid var(--gold);transition:.3s}
  .btn-gold{background:var(--gold);color:var(--navy-900)}
  .btn-gold:hover{background:transparent;color:var(--gold)}
  .btn-ghost{color:var(--text);border-color:var(--line)}
  .btn-ghost:hover{border-color:var(--gold);color:var(--gold)}

  /* NAV */
  nav{position:fixed;top:0;left:0;right:0;z-index:50;background:rgba(6,13,31,.85);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
  nav .wrap{display:flex;align-items:center;justify-content:space-between;height:78px}
  .logo{font-family:var(--sans);font-weight:600;letter-spacing:.18em;font-size:1.05rem}
  .logo span{color:var(--gold);font-weight:300;margin-left:6px;letter-spacing:.3em;font-size:.75rem}
  .nav-links{display:flex;gap:34px;align-items:center;font-size:.82rem;letter-spacing:.08em}
  .nav-links a:not(.btn):hover{color:var(--gold)}
  .nav-links .btn{padding:11px 22px}
  .burger{display:none;background:none;border:0;color:var(--text);font-size:1.6rem;cursor:pointer}

  /* HERO */
  .hero{min-height:100vh;display:flex;align-items:center;padding:140px 0 80px;border:0;
    background:radial-gradient(ellipse at 75% 30%, var(--navy-600) 0%, var(--navy-900) 60%)}
  .hero .wrap{display:grid;grid-template-columns:1.1fr .9fr;gap:70px;align-items:center}
  .hero p.lead{margin:26px 0 40px}
  .hero-cta{display:flex;gap:16px;flex-wrap:wrap}
  .hero-img{position:relative}
  .hero-img img{width:100%;aspect-ratio:4/5;object-fit:cover;filter:grayscale(15%) contrast(1.05)}
  .hero-img::before{content:"";position:absolute;inset:-18px 18px 18px -18px;border:1px solid var(--gold);z-index:-1;opacity:.5}
  .hero-note{margin-top:34px;font-size:.8rem;color:var(--muted);letter-spacing:.06em}
  .hero-note strong{color:var(--gold);font-weight:500}

  /* TRUST */
  .trust{padding:46px 0;background:var(--navy-800)}
  .trust p{text-align:center;font-size:.72rem;letter-spacing:.28em;text-transform:uppercase;color:var(--muted);margin-bottom:20px}
  .logos{display:flex;flex-wrap:wrap;justify-content:center;gap:16px 48px;font-family:var(--serif);font-size:1.25rem;color:#c6cee0;opacity:.85}

  /* SPLIT */
  .split{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}
  .checklist{list-style:none;margin-top:26px}
  .checklist li{padding:14px 0 14px 34px;border-bottom:1px solid var(--line);position:relative;color:var(--muted)}
  .checklist li::before{content:"—";position:absolute;left:0;color:var(--gold)}
  .quote-block{font-family:var(--serif);font-size:clamp(1.6rem,3vw,2.2rem);line-height:1.35;border-left:2px solid var(--gold);padding-left:30px}

  /* PILLARS */
  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);margin-top:56px}
  .card{background:var(--navy-900);padding:44px 36px;transition:.3s}
  .card:hover{background:var(--navy-800)}
  .card .num{font-family:var(--serif);color:var(--gold);font-size:1.1rem;margin-bottom:22px;display:block}
  .card p{color:var(--muted);font-size:.95rem}

  /* TEAM */
  .team{background:var(--navy-800)}
  .pills{display:flex;flex-wrap:wrap;gap:12px;margin-top:36px}
  .pills span{border:1px solid var(--line);padding:10px 20px;font-size:.85rem;letter-spacing:.04em}

  /* PROCESS */
  .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:30px;margin-top:56px}
  .step{border-top:1px solid var(--gold);padding-top:24px}
  .step small{color:var(--accent);letter-spacing:.2em;text-transform:uppercase;font-size:.7rem;font-weight:500}
  .step h3{margin-top:10px}
  .step p{color:var(--muted);font-size:.93rem}

  /* ABOUT */
  .about img{width:100%;aspect-ratio:4/5;object-fit:cover}
  .creds{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:36px}
  .creds div{border-top:1px solid var(--line);padding-top:14px}
  .creds strong{font-family:var(--serif);font-size:2rem;color:var(--gold);font-weight:500;display:block}
  .creds span{font-size:.78rem;color:var(--muted);letter-spacing:.06em}

  /* INVESTMENT */
  .invest{text-align:center;background:radial-gradient(ellipse at center, var(--navy-700) 0%, var(--navy-900) 70%)}
  .invest .lead{margin:0 auto 50px}
  .tiers{display:grid;grid-template-columns:repeat(2,1fr);gap:30px;max-width:900px;margin:0 auto 50px;text-align:left}
  .tier{border:1px solid var(--line);padding:44px 38px;background:rgba(6,13,31,.6)}
  .tier.featured{border-color:var(--gold)}
  .tier .tag{font-size:.7rem;letter-spacing:.24em;text-transform:uppercase;color:var(--gold);font-weight:500}
  .tier h3{margin:12px 0 6px}
  .tier .price{color:var(--muted);font-size:.9rem;margin-bottom:22px}
  .tier ul{list-style:none}
  .tier li{padding:8px 0 8px 26px;position:relative;font-size:.92rem;color:var(--muted)}
  .tier li::before{content:"✓";position:absolute;left:0;color:var(--accent)}

  /* TESTIMONIAL */
  .testi{text-align:center}
  .testi blockquote{font-family:var(--serif);font-size:clamp(1.5rem,3vw,2.1rem);max-width:860px;margin:0 auto 24px;line-height:1.4}
  .testi cite{font-style:normal;color:var(--muted);font-size:.85rem;letter-spacing:.12em;text-transform:uppercase}

  /* FAQ */
  .faq{max-width:820px;margin:50px auto 0}
  details{border-bottom:1px solid var(--line);padding:24px 0}
  summary{cursor:pointer;font-family:var(--serif);font-size:1.35rem;list-style:none;display:flex;justify-content:space-between;gap:20px}
  summary::-webkit-details-marker{display:none}
  summary::after{content:"+";color:var(--gold);font-family:var(--sans);font-weight:300}
  details[open] summary::after{content:"–"}
  details p{color:var(--muted);margin-top:14px}

  /* CTA + FOOTER */
  .cta{text-align:center;background:var(--navy-800)}
  .cta .lead{margin:0 auto 40px}
  footer{padding:60px 0 40px;border-top:1px solid var(--line);font-size:.85rem;color:var(--muted)}
  footer .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:30px}
  footer a:hover{color:var(--gold)}
  .foot-links{display:flex;gap:26px;flex-wrap:wrap}

  /* REVEAL */
  .reveal{opacity:0;transform:translateY(24px);transition:opacity .9s ease, transform .9s ease}
  .reveal.in{opacity:1;transform:none}

  /* RESPONSIVE */
  @media (max-width:960px){
    .hero .wrap,.split{grid-template-columns:1fr;gap:50px}
    .grid{grid-template-columns:1fr 1fr}
    .steps{grid-template-columns:1fr 1fr}
    .tiers{grid-template-columns:1fr}
  }
  @media (max-width:720px){
    section{padding:80px 0}
    .wrap{padding:0 16px}
    .nav-links{display:none;position:absolute;top:78px;left:0;right:0;flex-direction:column;background:var(--navy-900);padding:30px;gap:22px;border-bottom:1px solid var(--line)}
    .nav-links.open{display:flex}
    .burger{display:block}
    .grid,.steps{grid-template-columns:1fr}
    .creds{grid-template-columns:1fr 1fr 1fr}
    .hero-img::before{display:none}
  }
</style>
</head>
<body>

<!-- NAVIGATION -->
<nav>
  <div class="wrap">
    <a href="#" class="logo">LMFIT<span>PRIVATE</span></a>
    <button class="burger" aria-label="Menu" onclick="document.querySelector('.nav-links').classList.toggle('open')">☰</button>
    <div class="nav-links">
      <a href="#approach">Approach</a>
      <a href="#team">Your Team</a>
      <a href="#process">The Process</a>
      <a href="#about">About Liz</a>
      <a href="#faq">FAQ</a>
      <a href="#apply" class="btn btn-gold">Apply</a>
    </div>
  </div>
</nav>

<!-- HERO -->
<header class="hero">
  <div class="wrap">
    <div>
      <span class="eyebrow">Private Health &amp; Performance Coaching · London</span>
      <h1>Your career is at the top.<br>Your health should be <em>too.</em></h1>
      <p class="lead">A fully personalised, done-with-you programme for high-achieving women who lead businesses, teams and families — and refuse to compromise on energy, appearance or longevity. No diets. No fads. Just a precise plan, a world-class team, and results you can feel in the boardroom and at home.</p>
      <div class="hero-cta">
        <a href="#apply" class="btn btn-gold">Request a Private Consultation</a>
        <a href="#approach" class="btn btn-ghost">Discover the Approach</a>
      </div>
      <p class="hero-note"><strong>By application only</strong> · Limited client places each quarter</p>
    </div>
    <div class="hero-img">
      <!-- REPLACE with your new professional portrait -->
      <img src="https://www.lmfit.uk/images/hero-sit-and-smile.jpeg" alt="Liz Marsland, private health and performance coach for women in London">
    </div>
  </div>
</header>

<!-- TRUST -->
<div class="trust">
  <div class="wrap">
    <p>Trusted by leading organisations</p>
    <div class="logos">
      <span>Clifford Chance</span><span>The New York Times</span><span>Logicalis</span><span>Rand Merchant Bank</span><span>Workspace Group</span>
    </div>
  </div>
</div>

<!-- THE PROBLEM -->
<section id="approach">
  <div class="wrap split">
    <div class="reveal">
      <span class="eyebrow">Who this is for</span>
      <h2>You carry more than most people ever will.</h2>
      <p class="lead">You run at a level few understand — leading, deciding, parenting, showing up. But energy dips, sleep suffers, hormones shift, and the body that used to keep up starts asking questions.</p>
      <ul class="checklist">
        <li>You don't have time for trial and error, diets or the latest trend</li>
        <li>You want to look and feel sharp — and be taken seriously in every room</li>
        <li>You want data, not guesswork: hormones, biomarkers, real numbers</li>
        <li>You expect the same standard of service you deliver to your own clients</li>
      </ul>
    </div>
    <div class="reveal">
      <p class="quote-block">"Health isn't a project you squeeze in. It's the asset that funds everything else. Invest in it the way you'd invest in anything that matters."</p>
      <p style="margin-top:20px;color:var(--muted);font-size:.85rem;letter-spacing:.12em;text-transform:uppercase;padding-left:32px">— Liz Marsland, Founder</p>
    </div>
  </div>
</section>

<!-- PILLARS -->
<section>
  <div class="wrap">
    <div class="reveal">
      <span class="eyebrow">What's included</span>
      <h2>Every base covered. Nothing left to chance.</h2>
      <p class="lead">One programme, built entirely around you — your body, your diary, your goals — and managed end to end so you never have to coordinate a thing.</p>
    </div>
    <div class="grid reveal">
      <div class="card"><span class="num">01</span><h3>Hormone &amp; Biomarker Testing</h3><p>Comprehensive blood work and hormone profiling at the outset and throughout, so every decision is based on your physiology — not someone else's template.</p></div>
      <div class="card"><span class="num">02</span><h3>1-to-1 Strength Coaching</h3><p>Expert, private training with Liz — in a discreet studio, your home or your office — designed for strength, posture, longevity and a confident, capable body.</p></div>
      <div class="card"><span class="num">03</span><h3>Nutrition Without Dieting</h3><p>A realistic way of eating that fits business lunches, travel and family dinners. Energy-led, sustainable, and never restrictive.</p></div>
      <div class="card"><span class="num">04</span><h3>Recovery &amp; Restoration</h3><p>Curated access to physiotherapy, sports massage, spa therapies, sound healing and breathwork — because performance depends on recovery.</p></div>
      <div class="card"><span class="num">05</span><h3>Energy, Sleep &amp; Stress</h3><p>Practical strategies to manage cortisol, sleep deeply and sustain focus through long days and demanding seasons of life.</p></div>
      <div class="card"><span class="num">06</span><h3>Concierge-Level Support</h3><p>Direct access to Liz, regular reviews, and a plan that adapts the moment your schedule, travel or circumstances change.</p></div>
    </div>
  </div>
</section>

<!-- TEAM -->
<section class="team" id="team">
  <div class="wrap split">
    <div class="reveal">
      <span class="eyebrow">Your specialist team</span>
      <h2>A cohort of elite professionals — assembled around you.</h2>
      <p class="lead">You won't be handed off or left to search for the right people. Liz coordinates a trusted network of practitioners, matched to your needs and brought in exactly when they add value.</p>
    </div>
    <div class="reveal">
      <div class="pills">
        <span>Physiotherapists</span><span>Hormone &amp; Women's Health Specialists</span><span>Nutrition Experts</span><span>Massage Therapists</span><span>Spa &amp; Recovery Partners</span><span>Therapists &amp; Wellbeing Practitioners</span><span>Breathwork &amp; Sound Healing</span><span>Yoga &amp; Mobility</span><span>Image &amp; Style Partners</span>
      </div>
    </div>
  </div>
</section>

<!-- PROCESS -->
<section id="process">
  <div class="wrap">
    <div class="reveal">
      <span class="eyebrow">The process</span>
      <h2>Precise. Personal. Proven.</h2>
    </div>
    <div class="steps reveal">
      <div class="step"><small>Step one</small><h3>Private Consultation</h3><p>A confidential conversation about your goals, lifestyle, history and what success looks like for you.</p></div>
      <div class="step"><small>Step two</small><h3>Deep Assessment</h3><p>Hormone and biomarker testing, movement and posture analysis, and a full picture of sleep, stress and nutrition.</p></div>
      <div class="step"><small>Step three</small><h3>Your Blueprint</h3><p>A bespoke 12-week plan and your hand-picked specialist team — built around your diary, not the other way round.</p></div>
      <div class="step"><small>Step four</small><h3>Measure &amp; Refine</h3><p>Ongoing coaching, regular re-testing and reviews, so progress is visible, measurable and lasting.</p></div>
    </div>
  </div>
</section>

<!-- ABOUT -->
<section class="about" id="about">
  <div class="wrap split">
    <div class="reveal">
      <!-- REPLACE with your new professional image -->
      <img src="https://www.lmfit.uk/images/personal-trainer-london-training-client.jpg" alt="Liz Marsland coaching a client">
    </div>
    <div class="reveal">
      <span class="eyebrow">About Liz</span>
      <h2>Two decades of expertise. One focus: you.</h2>
      <p class="lead">Liz Marsland is a BSc Sports Science graduate with over 20 years of coaching experience, having worked alongside physiotherapists and with athletes, executives and women at every life stage. She brings together strength training, rehabilitation, yoga, breathwork, sound healing and massage into one integrated, evidence-based approach.</p>
      <p class="lead" style="margin-top:16px">Her corporate wellbeing work is trusted by organisations including Clifford Chance and The New York Times — and her private clients come to her for the same reason: she delivers, discreetly and without compromise.</p>
      <div class="creds">
        <div><strong>20+</strong><span>Years coaching</span></div>
        <div><strong>BSc</strong><span>Sports Science</span></div>
        <div><strong>500+</strong><span>Clients trained</span></div>
      </div>
    </div>
  </div>
</section>

<!-- INVESTMENT -->
<section class="invest">
  <div class="wrap">
    <div class="reveal">
      <span class="eyebrow">The investment</span>
      <h2>An investment in the asset that funds everything else.</h2>
      <p class="lead">Every programme is tailored, so pricing is confirmed after your consultation. Places are deliberately limited to guarantee a fully personalised experience.</p>
    </div>
    <div class="tiers reveal">
      <div class="tier">
        <span class="tag">Foundation</span>
        <h3>The 12-Week Reset</h3>
        <p class="price">Investment on application</p>
        <ul>
          <li>Hormone &amp; biomarker testing</li>
          <li>Bespoke 12-week training &amp; nutrition plan</li>
          <li>Weekly 1-to-1 coaching sessions</li>
          <li>Direct messaging support with Liz</li>
          <li>Re-test and review at week 12</li>
        </ul>
      </div>
      <div class="tier featured">
        <span class="tag">Signature</span>
        <h3>The Private Client Programme</h3>
        <p class="price">Investment on application</p>
        <ul>
          <li>Everything in Foundation</li>
          <li>Your coordinated specialist team</li>
          <li>Physio, massage &amp; spa recovery integrated</li>
          <li>Up to 3 sessions per week, anywhere in London</li>
          <li>Travel &amp; schedule-proof programming</li>
          <li>Priority, concierge-level access</li>
        </ul>
      </div>
    </div>
    <a href="#apply" class="btn btn-gold">Apply for a Place</a>
  </div>
</section>

<!-- TESTIMONIAL -->
<section class="testi">
  <div class="wrap reveal">
    <span class="eyebrow">Client words</span>
    <!-- Swap in testimonials from your executive clients when you have them -->
    <blockquote>"Within 8 weeks I was pain-free and stronger than I'd been in my 30s. She doesn't just train you — she educates you about your own body."</blockquote>
    <cite>Sarah M. · Marketing Director</cite>
  </div>
</section>

<!-- FAQ -->
<section id="faq">
  <div class="wrap">
    <div class="reveal" style="text-align:center">
      <span class="eyebrow">Questions</span>
      <h2>Before we begin</h2>
    </div>
    <div class="faq reveal">
      <details><summary>I have very little time. Will this work for me?</summary><p>It's designed for exactly that. Sessions fit your diary — early mornings, lunchtimes, at home or at your office — and everything else is coordinated for you. Efficiency is built in.</p></details>
      <details><summary>What does hormone and biomarker testing involve?</summary><p>A simple blood test arranged through a trusted partner, reviewed alongside your symptoms, energy and goals. It gives us a clear baseline and lets us track real change over time.</p></details>
      <details><summary>Is this a diet?</summary><p>No. There's no restriction, no fads and no counting your life away. You'll get a practical, sustainable approach to eating that supports energy, body composition and long-term health.</p></details>
      <details><summary>Where do sessions take place?</summary><p>At a private London studio, your home, your workplace or outdoors — whichever suits you best. Remote coaching is available when you travel.</p></details>
      <details><summary>Is everything confidential?</summary><p>Completely. Discretion is fundamental to how Liz works with every client and every member of the specialist team.</p></details>
      <details><summary>How do I start?</summary><p>Apply below for a private consultation. If we're the right fit, you'll receive a tailored proposal and investment within 48 hours.</p></details>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta" id="apply">
  <div class="wrap reveal">
    <span class="eyebrow">Limited places</span>
    <h2>Take your health as seriously as <em>everything else.</em></h2>
    <p class="lead">Request a private, no-obligation consultation with Liz. Places are limited each quarter to guarantee every client receives an exceptional, fully personalised experience.</p>
    <div class="hero-cta" style="justify-content:center">
      <a href="https://lmfit.as.me/?appointmentType=category:PT%20%2F%20LMFIT" class="btn btn-gold" target="_blank" rel="noopener">Request a Private Consultation</a>
      <a href="https://wa.me/447457405030" class="btn btn-ghost" target="_blank" rel="noopener">Message on WhatsApp</a>
    </div>
  </div>
</section>

<!-- FOOTER -->
<footer>
  <div class="wrap">
    <div>
      <div class="logo" style="margin-bottom:10px">LMFIT<span>PRIVATE</span></div>
      <p>Private health &amp; performance coaching for women · London</p>
    </div>
    <div class="foot-links">
      <a href="mailto:lmfit100@gmail.com">lmfit100@gmail.com</a>
      <a href="https://wa.me/447457405030">07457 405030</a>
      <a href="https://instagram.com/lmfit_trainer">Instagram</a>
      <a href="https://www.lmfit.uk">lmfit.uk</a>
    </div>
  </div>
  <div class="wrap" style="margin-top:30px;font-size:.75rem">© <span id="yr"></span> LMFIT · London · All rights reserved</div>
</footer>

<script>
  document.getElementById('yr').textContent = new Date().getFullYear();
  // close mobile menu on link click
  document.querySelectorAll('.nav-links a').forEach(a => a.addEventListener('click', () => document.querySelector('.nav-links').classList.remove('open')));
  // fade-in on scroll
  const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), {threshold:.12});
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
</script>
</body>
</html>
